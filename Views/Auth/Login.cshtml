@model ServiceHub_IT.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_LoginLayout";
}

<div class="card p-4 p-md-5 fade-in auth-card">
    <div class="text-center mb-4">
        <div class="auth-card-icon">S</div>
        <h3 class="fw-semibold mb-2">Welcome back</h3>
        <p class="text-muted mb-0">Access your ServiceHub IT workspace.</p>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <form asp-action="Login" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="name@company.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="Enter password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
        </div>
        <button class="btn btn-primary w-100">Continue</button>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="ForgotPassword" class="text-decoration-none">Forgot password?</a>
    </div>
    <div class="mt-2 text-center">
        <span>Don't have an account?</span>
        <a asp-action="SignUp" class="text-decoration-none">Create one</a>
    </div>

</div>
