@model List<Dictionary<string, object?>>
@{
    ViewData["Title"] = "Printable Report";
    var reportType = ViewBag.ReportType as string ?? "Report";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@reportType Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container py-4">
        <h2 class="mb-3">@reportType Report</h2>
        <p class="text-muted">Printable report generated for the selected date range.</p>
        <table class="table table-bordered">
            <thead>
                <tr>
                    @if (Model.Any())
                    {
                        foreach (var key in Model.First().Keys)
                        {
                            <th>@key</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        @foreach (var key in row.Keys)
                        {
                            <td>@row[key]</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
