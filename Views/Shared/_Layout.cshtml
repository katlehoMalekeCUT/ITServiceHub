<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ServiceHub IT</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-shell">
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
            var role = User?.IsInRole("Admin") == true ? "Admin" : User?.IsInRole("Technician") == true ? "Technician" : "Employee";
        }

        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-mark">S</div>
                <div>
                    <h4 class="mb-0">ServiceHub IT</h4>
                    <small>ITSM & Asset Platform</small>
                </div>
            </div>

            <div class="sidebar-section-title">Workspace</div>
            <ul class="nav nav-pills flex-column gap-1 mt-2">
                @if (role == "Admin")
                {
                    <li class="nav-item"><a class="nav-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock me-2"></i>Admin</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-detailed me-2"></i>Tickets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Assets" || currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index"><i class="bi bi-hdd-stack me-2"></i>Assets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Departments" ? "active" : "")" asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3 me-2"></i>Departments</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Reports</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "KnowledgeBase" ? "active" : "")" asp-controller="KnowledgeBase" asp-action="Index"><i class="bi bi-journal-text me-2"></i>Knowledge Base</a></li>
                }
                else if (role == "Technician")
                {
                    <li class="nav-item"><a class="nav-link @(currentController == "Technician" ? "active" : "")" asp-controller="Technician" asp-action="Index"><i class="bi bi-tools me-2"></i>Technician</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-detailed me-2"></i>Assigned Tickets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Maintenance" ? "active" : "")" asp-controller="Maintenance" asp-action="Index"><i class="bi bi-wrench-adjustable me-2"></i>Maintenance</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Assets" ? "active" : "")" asp-controller="Assets" asp-action="Index"><i class="bi bi-hdd-stack me-2"></i>Assets</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @(currentController == "Employee" ? "active" : "")" asp-controller="Employee" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Employee</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-detailed me-2"></i>My Tickets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "Assets" ? "active" : "")" asp-controller="Assets" asp-action="Index"><i class="bi bi-hdd-stack me-2"></i>My Assets</a></li>
                    <li class="nav-item"><a class="nav-link @(currentController == "KnowledgeBase" ? "active" : "")" asp-controller="KnowledgeBase" asp-action="Index"><i class="bi bi-journal-text me-2"></i>Knowledge Base</a></li>
                }
            </ul>
        </aside>

        <div class="content-panel">
            <nav class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <span class="topbar-title">Service Operations Center</span>
                    <span class="topbar-pill"><i class="bi bi-circle-fill me-2 text-success"></i>Live</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Profile" asp-action="Index">
                            <i class="bi bi-person-circle me-2"></i>Profile
                        </a>
                        <a class="btn btn-outline-primary btn-sm position-relative" asp-controller="Notifications" asp-action="Index">
                            <i class="bi bi-bell me-2"></i>Notifications
                            <span class="notification-badge" id="notificationBadge" data-role="badge">0</span>
                        </a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Auth" asp-action="Login">Sign In</a>
                    }
                </div>
            </nav>

            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('form[data-confirm="true"]').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    const confirmed = window.confirm('Are you sure you want to continue?');
                    if (!confirmed) {
                        event.preventDefault();
                    }
                });
            });

            const badge = document.getElementById('notificationBadge');
            if (!badge) {
                return;
            }

            const refreshBadge = function () {
                fetch('/Notifications/UnreadCount', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('Unable to load notification count');
                        }
                        return response.json();
                    })
                    .then(function (payload) {
                        const count = Number(payload?.count ?? 0);
                        badge.textContent = count > 0 ? count : '0';
                        badge.style.display = count > 0 ? 'inline-flex' : 'none';
                    })
                    .catch(function () {
                        badge.textContent = '0';
                        badge.style.display = 'none';
                    });
            };

            refreshBadge();
            window.setInterval(refreshBadge, 20000);
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
