@model ServiceHub_IT.Models.Ticket
@{
    ViewData["Title"] = "Ticket Details";
    var prediction = ViewBag.AiPrediction as ServiceHub_IT.Models.TicketPrediction;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h1 class="h4 mb-1">@Model.title</h1>
                        <p class="text-muted mb-0">@Model.description</p>
                    </div>
                    <span class="badge bg-primary">@Model.priority</span>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.status</dd>
                    <dt class="col-sm-4">Requester</dt>
                    <dd class="col-sm-8">@Model.requester</dd>
                    <dt class="col-sm-4">Assigned Technician</dt>
                    <dd class="col-sm-8">@Model.assigned_technician</dd>
                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.category</dd>
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.created_at?.ToString("g")</dd>
                    <dt class="col-sm-4">Due Date</dt>
                    <dd class="col-sm-8">@(Model.due_date is null ? "Not set" : Model.due_date.Value.ToString("g"))</dd>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.screenshot_url))
                {
                    <div class="mt-3">
                        <h5>Screenshot</h5>
                        <img src="@Model.screenshot_url" class="img-fluid rounded border" style="max-height: 320px;" />
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title">AI Recommendations</h5>
                @if (prediction is not null)
                {
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Predicted Priority:</strong> @prediction.Priority</li>
                        <li class="list-group-item"><strong>Estimated Resolution Time:</strong> @prediction.EstimatedResolutionHours hours</li>
                        <li class="list-group-item"><strong>Recommended Technician:</strong> @prediction.RecommendedTechnician</li>
                    </ul>
                }
            </div>
        </div>

        <div class="card shadow-sm">G
            <div class="card-body">
                <h5 class="card-title">Update Ticket</h5>
                <form asp-controller="HelpDesk" asp-action="AssignTicket" asp-route-id="@Model.id" method="post" class="ticket-action-form mb-3">
                    <button type="submit" class="btn btn-outline-primary w-100 ticket-action-btn">Assign Ticket</button>
                </form>
                <form asp-controller="HelpDesk" asp-action="AcceptTicket" asp-route-id="@Model.id" method="post" class="ticket-action-form mb-3">
                    <button type="submit" class="btn btn-outline-success w-100 ticket-action-btn">Accept Ticket</button>
                </form>
                <form asp-controller="HelpDesk" asp-action="UpdateStatus" asp-route-id="@Model.id" method="post">
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            <option selected="@(Model.status == "Open")">Open</option>
                            <option selected="@(Model.status == "Assigned")">Assigned</option>
                            <option selected="@(Model.status == "In Progress")">In Progress</option>
                            <option selected="@(Model.status == "Resolved")">Resolved</option>
                            <option selected="@(Model.status == "Closed")">Closed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assigned Technician</label>
                        <select name="AssignedTechnician" class="form-select">
                            <option value="">Unassigned</option>
                            @if (ViewBag.Technicians is IEnumerable<ServiceHub_IT.Models.Profile> technicians)
                            {
                                foreach (var technician in technicians)
                                {
                                    var displayName = string.IsNullOrWhiteSpace(technician.FullName)
                                        ? technician.Email
                                        : technician.FullName;
                                    <option value="@technician.Email" selected="@(string.Equals(Model.assigned_technician, technician.Email, StringComparison.OrdinalIgnoreCase))">@displayName</option>
                                }
                            }
                            else
                            {
                                <option value="@Model.assigned_technician">@Model.assigned_technician</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Due Date</label>
                        <input name="DueDate" type="datetime-local" class="form-control" value="@(Model.due_date?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Comment</label>
                        <textarea name="Comment" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary ticket-action-btn">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
