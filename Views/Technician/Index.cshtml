@model ServiceHub_IT.DTOs.TechnicianDashboardViewModel
@{
    ViewData["Title"] = "Technician Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="hero-panel">
        <div>
            <span class="hero-badge"><i class="bi bi-tools"></i>Technician</span>
            <h1 class="h4 mb-2 mt-3">Technician Dashboard</h1>
            <p class="text-muted mb-0">See your assigned work, due dates, and assets.</p>
        </div>
        <div class="topbar-pill"><i class="bi bi-calendar2-check me-2"></i>Service queue</div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6"><div class="card p-3 stat-card"><h6 class="text-muted">Completed Tasks</h6><h2 class="mb-0">@Model.CompletedCount</h2></div></div>
        <div class="col-md-6"><div class="card p-3 stat-card"><h6 class="text-muted">Pending Tasks</h6><h2 class="mb-0">@Model.DueSoonCount</h2></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card p-4">
                <h5 class="fw-semibold mb-3">Assigned Tickets</h5>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Title</th><th>Status</th><th>Details</th></tr></thead>
                        <tbody>
                            @foreach (var ticket in Model.Tickets)
                            {
                                <tr>
                                    <td>@ticket.title</td>
                                    <td><span class="badge bg-secondary">@ticket.status</span></td>
                                    <td>@ticket.description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card p-4">
                <h5 class="fw-semibold mb-3">Assigned Assets</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var asset in Model.Assets)
                    {
                        <li class="list-group-item">@asset.asset_name (@asset.status)</li>
                    }
                </ul>
                @if (!Model.Assets.Any())
                {
                    <p class="empty-state mb-0">No assets assigned yet.</p>
                }
            </div>
        </div>
    </div>
</div>
